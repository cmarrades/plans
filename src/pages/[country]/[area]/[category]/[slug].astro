  .small{font-size:14px;margin:0 0 10px}
  .tramos summary{cursor:pointer;font-weight:700;min-height:44px;display:flex;align-items:center}
  .legs{display:grid;gap:8px;margin:6px 0 12px}
  :global(.legs a){display:block;padding:10px 14px;border-radius:10px;background:var(--panel);text-decoration:none;font-weight:700}
  .rgrid{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:clamp(24px,4vw,56px)}
  .book{list-style:none;margin:0;padding:0}
