  .eatpick b{color:var(--red)}
  :global(.prio){font-size:12px;font-weight:800;border-radius:6px;padding:1px 7px;background:var(--panel);color:var(--mute)}
  :global(.prio.must){background:var(--red);color:#fff}
  .sun{margin:0;padding:10px 14px;border-radius:10px;background:var(--panel);font-weight:600}
  .sun.warn{background:#fde8e8;color:#8a1414}
