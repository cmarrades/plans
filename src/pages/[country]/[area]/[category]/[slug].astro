---
import Base from '../../../../layouts/Base.astro';
import { loadAll, cityUrl, listUrl } from '../../../../lib/plans';

export async function getStaticPaths() {
  const { plans } = await loadAll();
  return plans.map((p) => ({ params: { country: p.country, area: p.area, category: p.category, slug: p.slug }, props: { slug: p.slug } }));
}
const { slug } = Astro.props;
const { plans, cities, categories } = await loadAll();
const plan = plans.find((p) => p.slug === slug)!;
const cat = categories.find((c) => c.id === plan.category)!;
const baseCities = plan.bases.map((b) => ({ ...b, ...cities.find((c) => c.id === b.city)! }));
const home = baseCities[0];
const data = {
  slug: plan.slug, title: plan.title, country: plan.country, mode: cat.travelMode,
  stops: plan.stops, eats: plan.eats, approachEats: plan.approachEats,
  bases: baseCities.map((b) => ({ id: b.id, name: b.name, lat: b.lat, lng: b.lng })),
};
---
<Base title={`${plan.title} · ${cat.name}`} description={plan.summary}
  crumbs={[{ label: home.name, href: cityUrl(home.country, home.id) }, { label: cat.name, href: listUrl(home.country, home.id, cat.id) }, { label: plan.title }]}>

  <section class="dhead band" style={`--c:${cat.color}`}>
    <div class="wrap">
      <p class="area">{plan.areaName}</p>
      <h1>{plan.title}</h1>
      <p class="lead">{plan.summary}</p>
      <div class="dtags">{plan.tags.map((t) => <span class="tag">{t}</span>)}</div>
    </div>
  </section>

  <section class="origin band">
    <div class="wrap ogrid">
      <div class="ofrom">
        <label for="from"><b>Salgo desde</b></label>
        <div class="orow">
          <select id="from">
            {baseCities.map((b) => <option value={`city:${b.id}`}>{b.name}</option>)}
            <option value="me">Mi ubicación actual</option>
            <option value="addr">Otra dirección…</option>
          </select>
          <form id="addrform" class="addr" hidden>
            <input type="text" id="addr" placeholder="Calle, pueblo o código postal" autocomplete="street-address" />
            <button class="btn blue" type="submit">Usar</button>
          </form>
        </div>
        <p class="omsg muted" id="omsg" aria-live="polite"></p>
      </div>
      <div class="totals" aria-live="polite">
        <span class="hito"><b id="t-km">–</b><small>km en total</small></span>
        <span class="hito"><b id="t-time">–</b><small>en moto</small></span>
        <span class="hito"><b>{plan.stops.length}</b><small>paradas</small></span>
      </div>
    </div>
  </section>

  <section class="band tripband" id="tripband">
    <div class="wrap">
      <div class="tstart" id="trip-start">
        <div>
          <h2>¿Ya estás en ruta?</h2>
          <p class="muted">Si has parado a comer o a descansar, sigue desde donde estás: te enseño lo que te queda y a qué hora llegas.</p>
          <p class="resume" id="trip-resume" hidden></p>
        </div>
        <div class="tbtns">
          <button class="btn red big" id="trip-go" type="button">Estoy en ruta: seguir desde aquí</button>
          <button class="btn ghost" id="trip-drop" type="button" hidden>Descartar la ruta a medias</button>
        </div>
      </div>
      <div class="trip" id="trip" hidden>
        <div class="thead">
          <h2>Lo que te queda</h2>
          <button class="btn ghost" id="trip-end" type="button">Terminar ruta</button>
        </div>
        <p class="tmsg" id="trip-msg" aria-live="polite"></p>
        <div class="ask" id="trip-ask" hidden>
          <p id="trip-q"></p>
          <div class="orow">
            <button class="btn blue" id="ask-yes" type="button">Sí</button>
            <button class="btn ghost" id="ask-no" type="button">No</button>
          </div>
        </div>
        <div class="fix">
          <button class="lnk" id="fix-ahead" type="button"></button>
          <button class="lnk" id="fix-back" type="button"></button>
          <button class="lnk" id="trip-loc" type="button">Actualizar mi posición</button>
        </div>
        <div class="budget">
          <b>¿Cuánto tiempo tienes?</b>
          <div class="filters" id="budget" role="group" aria-label="Tiempo disponible">
            <button type="button" class="f on" data-b="none">Sin prisa</button>
            <button type="button" class="f" data-b="60">1 h</button>
            <button type="button" class="f" data-b="120">2 h</button>
            <button type="button" class="f" data-b="180">3 h</button>
            <button type="button" class="f" data-b="sun">Llegar de día</button>
            <button type="button" class="f" data-b="until">Hasta las…</button>
          </div>
          <form class="orow" id="until-form" hidden>
            <input type="time" id="until" aria-label="Tengo que estar en casa a las" />
            <button class="btn blue" type="submit">Calcular</button>
          </form>
        </div>
        <p class="plan" id="trip-plan" hidden></p>
        <div class="totals" aria-live="polite">
          <span class="hito"><b id="tr-km">–</b><small>km quedan</small></span>
          <span class="hito"><b id="tr-time">–</b><small>en moto</small></span>
          <span class="hito"><b id="tr-eta">–</b><small>llegada</small></span>
          <span class="hito"><b id="tr-stops">–</b><small>paradas</small></span>
        </div>
        <p class="sun" id="trip-sun" hidden></p>
        <a class="eatpick" id="trip-eatpick" href="#" target="_blank" rel="noopener" hidden></a>
        <ol class="book" id="trip-list"></ol>
        <div class="tacts">
          <a class="btn red big" id="trip-gm" href="#" target="_blank" rel="noopener">Seguir ruta en Google Maps</a>
          <a class="btn blue" id="trip-gm1" href="#" target="_blank" rel="noopener">Solo hasta la próxima parada</a>
          <button class="btn ghost" id="trip-skip" type="button">Saltar la siguiente parada</button>
          <a class="btn ghost" id="trip-home" href="#" target="_blank" rel="noopener">Volver directo a casa</a>
        </div>
        <p class="muted small">Google Maps sale desde donde estés en ese momento. En Maps, activa «Evitar autopistas».</p>
        <div id="trip-eats-box" hidden>
          <h3>Para comer lo que te queda</h3>
          <div class="eats" id="trip-eats"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="band mapband">
    <div class="wrap mgrid">
      <div class="mapbox"><div id="map" role="img" aria-label="Mapa del recorrido"></div></div>
      <div class="actions">
        <h2>Llévatelo</h2>
        <a class="btn red big" id="gm-full" href="#" target="_blank" rel="noopener">Abrir recorrido completo en Google Maps</a>
        <p class="muted small">Desde tu salida, por todas las paradas en orden y vuelta. En Maps, activa «Evitar autopistas».</p>
        <details class="tramos">
          <summary>Si el móvil no acepta tantas paradas, ábrelo por tramos</summary>
          <div id="gm-legs" class="legs"></div>
        </details>
        <button class="btn blue big" id="gpx" type="button">Descargar GPX</button>
        <p class="muted small">Con el trazado completo para Calimoto, OsmAnd, Kurviger o el navegador de la moto.</p>
      </div>
    </div>
  </section>

  <section class="band" style="padding-top:0">
    <div class="wrap rgrid">
      <div>
        <h2>Road book</h2>
        <ol class="book" id="book">
          {plan.stops.map((s) => (
            <li><span class="hito"><b>–</b><small>km</small></span><div><h3>{s.name} <span class="kind">{s.kind}</span></h3>{s.note && <p class="muted">{s.note}</p>}</div></li>
          ))}
        </ol>
      </div>
      <div>
        <h2>Antes de salir</h2>
        {plan.tips.map((t) => <div class="tip"><h3>{t.t}</h3><p class="muted">{t.d}</p></div>)}
      </div>
    </div>
  </section>

  <section class="band eatband" id="comer">
    <div class="wrap">
      <h2>Dónde almorzar y comer</h2>
      <p class="muted">Ordenado por el kilómetro en que te lo encuentras en tu recorrido. Toca uno y Google Maps te lleva.</p>
      <div class="filters" role="group" aria-label="Filtrar sitios">
        <button type="button" class="f on" data-f="">Todos</button>
        <button type="button" class="f" data-f="almuerzo">Almorzar</button>
        <button type="button" class="f" data-f="comida">Comer</button>
        <button type="button" class="f" data-f="top">Imprescindibles</button>
        <button type="button" class="f" data-f="near">Cerca de mí ahora</button>
      </div>
      <div class="eats" id="eats"></div>
    </div>
  </section>

  <script type="application/json" id="plan-data" set:html={JSON.stringify(data)} />
</Base>

<style>
