  .pin{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:#fff;color:#0d4c92;border:3px solid #0d4c92;font-weight:900;font-size:13px;box-shadow:0 2px 6px #0005}
  .pin.o{background:#d62f2f;border-color:#fff;color:#fff}
  .pin.e{width:22px;height:22px;background:#d62f2f;border-color:#fff;color:#fff;font-size:11px}
  .pin.d{background:#e4e8ee;border-color:#8c99a8;color:#5b6878}
  .pin.m{width:22px;height:22px;background:#1a73e8;border-color:#fff;box-shadow:0 0 0 6px #1a73e855}
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  type Pt = { lat: number; lng: number };
  type Stop = Pt & { id: string; name: string; kind: string; maps: string; note?: string; prio?: 'must' | 'good' | 'optional'; dwell?: number };
  type Eat = { name: string; where: string; q: string; types: string[]; desc: string; top?: boolean; near?: string; lat?: number; lng?: number };
  const P = JSON.parse(document.getElementById('plan-data')!.textContent!) as {
    slug: string; title: string; country: string; mode: string; stops: Stop[]; eats: Eat[]; approachEats: Eat[];
    bases: { id: string; name: string; lat: number; lng: number }[];
  };

  const $ = (id: string) => document.getElementById(id)!;
  const fmtMin = (m: number) => { const h = Math.floor(m / 60), r = Math.round(m % 60); return h ? (r ? `${h} h ${r}` : `${h} h`) : `${r} min`; };
  const hav = (a: Pt, b: Pt) => { const r = (x: number) => x * Math.PI / 180, R = 6371;
    const h = Math.sin(r(b.lat - a.lat) / 2) ** 2 + Math.cos(r(a.lat)) * Math.cos(r(b.lat)) * Math.sin(r(b.lng - a.lng) / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(h)); };
  const PRIO = { must: 'Imprescindible', good: '', optional: 'Si da tiempo' } as const;
  const prioTag = (s: Stop) => { const k = s.prio ?? 'good'; return PRIO[k] ? ` <span class="prio ${k}">${PRIO[k]}</span>` : ''; };
  const dwellTxt = (s: Stop) => (s.dwell ?? 10) >= 15 ? ` · parada ~${s.dwell} min` : '';
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

  // ---------- Mapa ----------
  const map = L.map('map', { scrollWheelZoom: false });
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 18, attribution: '© OpenStreetMap' }).addTo(map);
  const layer = L.layerGroup().addTo(map);
  const pin = (html: string, cls = '') => L.divIcon({ className: '', html: `<span class="pin ${cls}">${html}</span>`, iconSize: [28, 28], iconAnchor: [14, 14] });

  // ---------- Estado ----------
  let origin: Pt & { name: string } = { ...P.bases[0] };
  let route: { geom: [number, number][]; cum: number[]; legKm: number[]; legMin: number[]; real: boolean } | null = null;
  let eatFilter = '';
  let me: Pt | null = null;

  async function osrm(seq: Pt[], exclude: boolean) {
    const profile = P.mode === 'walking' ? 'foot' : 'driving';
    const coords = seq.map((p) => `${p.lng.toFixed(5)},${p.lat.toFixed(5)}`).join(';');
    const u = `https://router.project-osrm.org/route/v1/${profile}/${coords}?overview=full&geometries=geojson${exclude ? '&exclude=motorway' : ''}`;
    const r = await fetch(u); if (!r.ok) throw new Error('osrm ' + r.status);
    const j = await r.json(); if (j.code !== 'Ok') throw new Error(j.code);
    return j.routes[0];
  }

  async function compute() {
    const seq: Pt[] = [origin, ...P.stops, origin];
    $('omsg').textContent = 'Calculando el recorrido…';
    try {
      let r; try { r = await osrm(seq, true); } catch { r = await osrm(seq, false); }
      const geom = r.geometry.coordinates.map(([x, y]: number[]) => [y, x]) as [number, number][];
      const cum = [0]; for (let i = 1; i < geom.length; i++) cum.push(cum[i - 1] + hav({ lat: geom[i - 1][0], lng: geom[i - 1][1] }, { lat: geom[i][0], lng: geom[i][1] }));
      route = { geom, cum, legKm: r.legs.map((l: any) => l.distance / 1000), legMin: r.legs.map((l: any) => l.duration / 60 * 1.1), real: true };
      $('omsg').textContent = `Recorrido calculado por carreteras desde ${origin.name}, evitando autovías cuando se puede.`;
    } catch {
      const legKm = seq.slice(1).map((p, i) => hav(seq[i], p) * 1.3);
      route = { geom: seq.map((p) => [p.lat, p.lng]), cum: [], legKm, legMin: legKm.map((k) => k / 50 * 60), real: false };
      $('omsg').textContent = 'No he podido calcular las carreteras ahora mismo: distancias aproximadas.';
    }
    render();
  }

  // km acumulado en cada punto de la secuencia (0 = salida)
  const atSeq = () => { const a = [0]; route!.legKm.forEach((k, i) => a.push(a[i] + k)); return a; };
  const minSeq = () => { const a = [0]; route!.legMin.forEach((k, i) => a.push(a[i] + k)); return a; };

  // km del recorrido más cercano a un punto (y a qué distancia queda)
  function along(p: Pt) {
    if (!route!.real) {
      const seq: Pt[] = [origin, ...P.stops, origin]; const a = atSeq();
      let best = 0, bd = Infinity; seq.forEach((q, i) => { const d = hav(p, q); if (d < bd) { bd = d; best = i; } });
      return { km: a[best], off: bd };
    }
    let best = 0, bd = Infinity;
    route!.geom.forEach(([la, ln], i) => { const d = hav(p, { lat: la, lng: ln }); if (d < bd) { bd = d; best = i; } });
    return { km: route!.cum[best], off: bd };
  }

  function mapsDir(points: (Pt & { maps?: string })[]) {
    const v = (p: Pt & { maps?: string }) => encodeURIComponent(p.maps ?? `${p.lat.toFixed(5)},${p.lng.toFixed(5)}`);
    const o = points[0], d = points[points.length - 1], w = points.slice(1, -1);
    return `https://www.google.com/maps/dir/?api=1&travelmode=${P.mode === 'walking' ? 'walking' : 'driving'}&origin=${v(o)}&destination=${v(d)}` + (w.length ? `&waypoints=${w.map(v).join('%7C')}` : '');
  }

  function render() {
    const a = atSeq(), m = minSeq();
    const total = a[a.length - 1], tmin = m[m.length - 1];
    $('t-km').textContent = String(Math.round(total));
    $('t-time').textContent = fmtMin(tmin);

    // Mapa
    layer.clearLayers();
    const line = L.polyline(route!.geom, { color: '#d62f2f', weight: 5, opacity: .9 }).addTo(layer);
    L.marker([origin.lat, origin.lng], { icon: pin('S', 'o'), title: 'Salida' }).addTo(layer).bindPopup(`<b>Salida</b><br>${esc(origin.name)}`);
    P.stops.forEach((s, i) => L.marker([s.lat, s.lng], { icon: pin(String(i + 1)) }).addTo(layer).bindPopup(`<b>${esc(s.name)}</b><br>${esc(s.note ?? '')}`));
    map.fitBounds(line.getBounds(), { padding: [24, 24] });

    // Road book
    const rows = [`<li><span class="hito"><b>0</b><small>km</small></span><div><h3>Salida <span class="kind">${esc(origin.name)}</span></h3></div></li>`]
      .concat(P.stops.map((s, i) => `<li><span class="hito"><b>${Math.round(a[i + 1])}</b><small>km</small></span><div><h3>${esc(s.name)} <span class="kind">${esc(s.kind)}</span>${prioTag(s)}</h3><div class="t">+${fmtMin(m[i + 1])} desde la salida${dwellTxt(s)}</div>${s.note ? `<p class="muted">${esc(s.note)}</p>` : ''}<button type="button" class="here" data-i="${i}">Estoy aquí: seguir desde esta parada</button></div></li>`))
      .concat(`<li><span class="hito"><b>${Math.round(total)}</b><small>km</small></span><div><h3>Llegada <span class="kind">${esc(origin.name)}</span></h3><div class="t">≈ ${fmtMin(tmin)} en total, sin paradas</div></div></li>`);
    $('book').innerHTML = rows.join('');

    // Google Maps
    const pts = [{ ...origin, maps: undefined }, ...P.stops, { ...origin, maps: undefined }];
    ($('gm-full') as HTMLAnchorElement).href = mapsDir(pts);
    const legs: string[] = []; // tramos de máx. 3 paradas intermedias
    for (let i = 0; i < pts.length - 1; i += 4) {
      const chunk = pts.slice(i, i + 5);
      legs.push(`<a href="${mapsDir(chunk)}" target="_blank" rel="noopener">Tramo ${legs.length + 1}: ${esc(i === 0 ? origin.name : (chunk[0] as Stop).name)} → ${esc(chunk[chunk.length - 1] === pts[pts.length - 1] ? origin.name : (chunk[chunk.length - 1] as Stop).name)}</a>`);
    }
    $('gm-legs').innerHTML = legs.join('');

    renderEats();
    if (trip) renderTrip();
  }

  function renderEats() {
    const a = atSeq();
    const idx = (id?: string) => P.stops.findIndex((s) => s.id === id);
    let list = P.eats.map((e) => {
      const i = idx(e.near); const s = P.stops[i];
      return { ...e, km: i >= 0 ? a[i + 1] : along(e as Pt).km, pt: i >= 0 ? s : (e as Pt) };
    });
    // Sitios de la aproximación: solo si quedan a menos de 2 km de tu recorrido
    P.approachEats.forEach((e) => { const r = along(e as Pt); if (r.off < 2) list.push({ ...e, km: r.km, pt: e as Pt }); });
    if (eatFilter === 'near' && me) list = list.map((e) => ({ ...e, d: hav(me!, e.pt) * 1.3 })).sort((x: any, y: any) => x.d - y.d) as any;
    else list.sort((x, y) => x.km - y.km);
    if (eatFilter && eatFilter !== 'near') list = list.filter((e) => eatFilter === 'top' ? e.top : e.types.includes(eatFilter));
    const tag: Record<string, string> = { almuerzo: 'Almorzar', comida: 'Comer' };
    $('eats').innerHTML = list.map((e: any) => {
      const left = eatFilter === 'near' && me ? `<b>${e.d < 1 ? '<1' : Math.round(e.d)}</b><small>km de ti</small>` : `<b>${Math.round(e.km)}</b><small>km ruta</small>`;
      return `<a class="eat" href="https://www.google.com/maps/dir/?api=1&travelmode=driving&destination=${encodeURIComponent(e.q)}" target="_blank" rel="noopener"><span class="hito">${left}</span><div><h3>${esc(e.name)}</h3><div class="where">${esc(e.where)}</div><p>${esc(e.desc)}</p><div class="chips">${e.types.map((t: string) => `<span class="chip">${tag[t]}</span>`).join('')}${e.top ? '<span class="chip t">Imprescindible</span>' : ''}</div></div></a>`;
    }).join('') || '<p class="muted">Nada con este filtro.</p>';
  }

  // ---------- GPX ----------
  $('gpx').addEventListener('click', () => {
    if (!route) return;
    const x = (s: string) => esc(s);
    const wpts = [{ ...origin, name: 'Salida: ' + origin.name }, ...P.stops].map((p) => `<wpt lat="${p.lat}" lon="${p.lng}"><name>${x(p.name)}</name></wpt>`).join('\n');
    const trk = route.geom.map(([la, ln]) => `<trkpt lat="${la.toFixed(6)}" lon="${ln.toFixed(6)}"/>`).join('');
    const rte = [origin, ...P.stops, origin].map((p: any) => `<rtept lat="${p.lat}" lon="${p.lng}"><name>${x(p.name)}</name></rtept>`).join('\n');
    const gpx = `<?xml version="1.0" encoding="UTF-8"?>\n<gpx version="1.1" creator="Planes" xmlns="http://www.topografix.com/GPX/1/1">\n<metadata><name>${x(P.title)}</name></metadata>\n${wpts}\n<rte><name>${x(P.title)}</name>\n${rte}\n</rte>\n<trk><name>${x(P.title)}</name><trkseg>${trk}</trkseg></trk>\n</gpx>\n`;
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([gpx], { type: 'application/gpx+xml' }));
    a.download = `${P.slug}.gpx`; document.body.appendChild(a); a.click(); a.remove();
  });

  // ---------- Salida ----------
  const sel = $('from') as HTMLSelectElement;
  const store = (v: string) => { try { localStorage.setItem('plans-origin', v); } catch {} };
  function useMe() {
    if (!navigator.geolocation) { $('omsg').textContent = 'Tu navegador no da la ubicación.'; return; }
    $('omsg').textContent = 'Buscando tu ubicación…';
    navigator.geolocation.getCurrentPosition((p) => {
      me = { lat: p.coords.latitude, lng: p.coords.longitude };
      origin = { ...me, name: 'Tu ubicación' }; compute();
    }, () => { $('omsg').textContent = 'No he podido obtener tu ubicación. Revisa el permiso del navegador.'; }, { timeout: 10000, maximumAge: 120000 });
  }
  sel.addEventListener('change', () => {
    const v = sel.value; ($('addrform') as HTMLFormElement).hidden = v !== 'addr';
    if (v.startsWith('city:')) { origin = { ...P.bases.find((b) => 'city:' + b.id === v)! }; store(v); compute(); }
    else if (v === 'me') { store(v); useMe(); }
    else ($('addr') as HTMLInputElement).focus();
  });
  $('addrform').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const q = ($('addr') as HTMLInputElement).value.trim(); if (!q) return;
    $('omsg').textContent = 'Buscando la dirección…';
    try {
      const r = await fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=1&countrycodes=${P.country}&q=${encodeURIComponent(q)}`);
      const j = await r.json();
      if (!j.length) { $('omsg').textContent = 'No encuentro esa dirección. Prueba con pueblo y calle.'; return; }
      origin = { lat: +j[0].lat, lng: +j[0].lon, name: q }; compute();
    } catch { $('omsg').textContent = 'No he podido buscar la dirección ahora mismo.'; }
  });

  document.querySelectorAll<HTMLButtonElement>('.f').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('.f').forEach((x) => x.classList.toggle('on', x === b));
    eatFilter = b.dataset.f || '';
    if (eatFilter === 'near' && !me) {
      if (!navigator.geolocation) return;
      navigator.geolocation.getCurrentPosition((p) => { me = { lat: p.coords.latitude, lng: p.coords.longitude }; renderEats(); }, () => {}, { timeout: 10000 });
    }
    renderEats();
  }));

  // ---------- En ruta: seguir desde donde estás ----------
  type Place = Pt & { name: string };
  type Budget = { k: 'none' | 'min' | 'until' | 'sun'; key: string; label: string; at?: number };
  type Trip = { home: Place; from: Place; next: number; skip: string[]; budget: Budget; t: number };
  type Ask = { q: string; yes: number; no: number };
  const TKEY = 'plans-trip:' + P.slug, TMAX = 12 * 3600e3;
  const NOB: Budget = { k: 'none', key: 'none', label: 'Sin prisa' };
  const W = { must: 100, good: 30, optional: 8 } as const; // qué pesa cada parada al recortar
  let trip: Trip | null = null;
  let tripMsg = '';
  let ask: Ask | null = null;
  let lastRem: Stop[] = [];
  let tRoute: { key: string; geom: [number, number][]; legKm: number[]; legMin: number[]; real: boolean } | null = null;
  let tMat: { key: string; min: number[][] } | null = null;
  let tSeq = 0;

  const saveTrip = () => { try { trip ? localStorage.setItem(TKEY, JSON.stringify({ ...trip, t: Date.now() })) : localStorage.removeItem(TKEY); } catch {} };
  const loadTrip = (): Trip | null => {
    try { const t = JSON.parse(localStorage.getItem(TKEY) || 'null'); return t && Date.now() - t.t < TMAX && t.home && t.from ? { budget: NOB, skip: [], ...t } : null; } catch { return null; }
  };
  const clock = (d: Date | number) => new Date(d).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
  const kmTxt = (k: number) => `${k < 10 ? k.toFixed(1).replace('.', ',') : Math.round(k)} km`;
  const defaultHome = (): Place => origin.name === 'Tu ubicación' ? { ...P.bases[0] } : { ...origin };
  const stopMin = (s: Stop) => s.dwell ?? 10;
  const nextName = (n: number, t: Trip) => n < P.stops.length ? P.stops[n].name : `la vuelta a ${t.home.name}`;
  const keyOf = (pts: Pt[]) => JSON.stringify(pts.map((p) => [p.lat.toFixed(4), p.lng.toFixed(4)]));

  // Puesta de sol (ecuación del amanecer; ±2 min, suficiente para avisar)
  function sunset(d: Date, p: Pt): Date | null {
    const rad = Math.PI / 180, jd = d.getTime() / 86400000 + 2440587.5;
    const n = Math.round(jd - 2451545 - 0.0009 - p.lng / 360);
    const js = n + 0.0009 - p.lng / 360 + 2451545;
    const M = (357.5291 + 0.98560028 * (js - 2451545)) % 360;
    const C = 1.9148 * Math.sin(M * rad) + 0.02 * Math.sin(2 * M * rad) + 0.0003 * Math.sin(3 * M * rad);
    const lam = (M + C + 180 + 102.9372) % 360;
    const jt = js + 0.0053 * Math.sin(M * rad) - 0.0069 * Math.sin(2 * lam * rad);
    const dec = Math.asin(Math.sin(lam * rad) * Math.sin(23.4397 * rad));
    const cw = (Math.sin(-0.833 * rad) - Math.sin(p.lat * rad) * Math.sin(dec)) / (Math.cos(p.lat * rad) * Math.cos(dec));
    if (cw < -1 || cw > 1) return null;
    return new Date((jt + Math.acos(cw) / rad / 360 - 2440587.5) * 86400000);
  }

  // ¿Por dónde vas? Te reincorpora al punto más cercano del recorrido, sin preguntarte la parada
  function locate(p: Pt, prior: Trip | null): { next: number; msg: string; ask?: Ask } {
    const near = P.stops.map((s, i) => ({ i, d: hav(p, s) })).sort((a, b) => a.d - b.d)[0];
    if (near.d < 0.6) return { next: near.i + 1, msg: `Estás en ${P.stops[near.i].name}: sigues desde aquí.` };
    const pn = prior?.next;
    if (!route || !route.real) {
      const n = pn ?? near.i;
      return { next: n, msg: `Te he situado cerca de ${P.stops[near.i].name}.`, ask: pn === undefined ? { q: `¿Ya has pasado por ${P.stops[near.i].name}?`, yes: near.i + 1, no: near.i } : undefined };
    }
    const g = route.geom, at = (k: number) => ({ lat: g[k][0], lng: g[k][1] });
    // índice de cada parada en el trazado, buscando siempre hacia delante
    const sIdx: number[] = []; let from = 0;
    P.stops.forEach((s) => { let b = from, bd = Infinity; for (let k = from; k < g.length; k++) { const d = hav(s, at(k)); if (d < bd) { bd = d; b = k; } } sIdx.push(b); from = b; });
    const nOf = (k: number) => { const n = sIdx.findIndex((x) => x > k); return n < 0 ? P.stops.length : n; };
    const d = g.map((_, k) => hav(p, at(k)));
    const bd = Math.min(...d), tol = Math.max(0.5, bd * 0.25);
    // en rutas de ida y vuelta, el mismo tramo puede ser la ida o la vuelta: todas las opciones cercanas
    const cn = [...new Set(d.flatMap((x, k) => x <= bd + tol ? [nOf(k)] : []))].sort((a, b) => a - b);
    const next = pn !== undefined ? (cn.find((n) => n >= pn) ?? pn) : cn[0];
    const where = bd < 0.5 ? 'Estás en la ruta' : bd < 3 ? `Estás a ${kmTxt(bd)} de la ruta` : `Estás a ${kmTxt(bd)} de la ruta: te llevo al punto más cercano para reincorporarte`;
    const q = pn === undefined && cn.length > 1 ? { q: cn[1] === P.stops.length ? '¿Ya has hecho la ruta y estás volviendo a casa?' : `¿Ya has pasado por ${P.stops[cn[1] - 1].name}?`, yes: cn[1], no: cn[0] } : undefined;
    return { next, msg: `${where}.`, ask: q };
  }

  async function osrmTable(pts: Pt[]): Promise<number[][]> {
    const profile = P.mode === 'walking' ? 'foot' : 'driving';
    const coords = pts.map((p) => `${p.lng.toFixed(5)},${p.lat.toFixed(5)}`).join(';');
    const r = await fetch(`https://router.project-osrm.org/table/v1/${profile}/${coords}?annotations=duration`);
    if (!r.ok) throw new Error('osrm ' + r.status);
    const j = await r.json(); if (j.code !== 'Ok') throw new Error(j.code);
    return j.durations.map((row: (number | null)[]) => row.map((x) => x == null ? Infinity : x / 60 * 1.1));
  }

  // Mejor combinación de paradas (en el orden de la ruta) que cabe en el tiempo disponible
  function best(cand: Stop[], M: number[][], avail: number) {
    const n = Math.min(cand.length, 12), H = cand.length + 1;
    let bm = -1, bs = -1, bt = Infinity;
    for (let mask = 0; mask < 1 << n; mask++) {
      let prev = 0, t = 0, sc = 0;
      for (let i = 0; i < n; i++) if (mask & (1 << i)) { t += M[prev][i + 1] + stopMin(cand[i]); sc += W[cand[i].prio ?? 'good']; prev = i + 1; }
      t += M[prev][H];
      if (t <= avail && (sc > bs || (sc === bs && t < bt))) { bs = sc; bt = t; bm = mask; }
    }
    return bm < 0 ? null : { keep: cand.filter((_, i) => bm & (1 << i)), min: bt };
  }

  function deadline(b: Budget, now: Date, at: Pt): Date | null {
    if (b.k === 'min' || b.k === 'until') return new Date(b.at!);
    if (b.k === 'sun') return sunset(now, at);
    return null;
  }

  function showTripUI() {
    const on = !!trip;
    ($('trip') as HTMLElement).hidden = !on;
    ($('trip-start') as HTMLElement).hidden = on;
    const saved = on ? null : loadTrip();
    const rs = $('trip-resume') as HTMLElement, dr = $('trip-drop') as HTMLElement;
    rs.hidden = dr.hidden = !saved;
    if (saved) rs.textContent = `Tienes esta ruta a medias: ${saved.next < P.stops.length ? 'te toca ' + P.stops[saved.next].name : 'solo te queda volver'}.`;
    $('trip-go').textContent = saved ? 'Seguir la ruta desde aquí' : 'Estoy en ruta: seguir desde aquí';
  }

  async function renderTrip() {
    if (!trip) return;
    const t = trip, my = ++tSeq, now = new Date();

    // Preguntas y correcciones (sin tener que saberte la ruta)
    ($('trip-ask') as HTMLElement).hidden = !ask;
    if (ask) $('trip-q').textContent = ask.q;
    const fa = $('fix-ahead') as HTMLButtonElement, fb = $('fix-back') as HTMLButtonElement;
    fa.hidden = t.next >= P.stops.length; if (!fa.hidden) fa.textContent = `Ya he pasado por ${P.stops[t.next].name}`;
    fb.hidden = t.next === 0; if (!fb.hidden) fb.textContent = `Aún no he llegado a ${P.stops[t.next - 1].name}`;
    document.querySelectorAll<HTMLButtonElement>('#budget .f').forEach((b) => b.classList.toggle('on', b.dataset.b === t.budget.key));
    $('trip-msg').textContent = `${tripMsg || `Siguiendo desde ${t.from.name}.`} Próxima parada: ${nextName(t.next, t)}.`;

    // ¿Qué cabe en el tiempo que tienes?
    const cand = P.stops.slice(t.next).filter((s) => !t.skip.includes(s.id));
    const dl = deadline(t.budget, now, t.from);
    let rem = cand, note = '', warn = false;
    const planEl = $('trip-plan') as HTMLElement;
    if (dl) {
      const pts: Pt[] = [t.from, ...cand, t.home], key = keyOf(pts);
      if (!tMat || tMat.key !== key) {
        planEl.hidden = false; planEl.classList.remove('warn'); planEl.textContent = 'Calculando qué te da tiempo a hacer…';
        let M: number[][]; try { M = await osrmTable(pts); } catch { M = pts.map((a) => pts.map((b) => hav(a, b) * 1.3 / 50 * 60)); }
        if (my !== tSeq || !trip) return;
        tMat = { key, min: M };
      }
      const avail = (dl.getTime() - now.getTime()) / 60000;
      const b = best(cand, tMat.min, avail);
      const label = t.budget.k === 'sun' ? `Para llegar de día (anochece a las ${clock(dl)})` : t.budget.label;
      if (!b) {
        rem = []; warn = true;
        const direct = tMat.min[0][cand.length + 1];
        note = `${label} no da tiempo ni volviendo directo: vuelve ya y llegas hacia las ${clock(now.getTime() + direct * 60000)}, unos ${fmtMin(Math.max(1, direct - avail))} tarde.`;
      } else {
        rem = b.keep; const out = cand.filter((s) => !rem.includes(s));
        if (!out.length) note = `${label} te da tiempo a todo lo que queda, y te sobran unos ${fmtMin(Math.max(0, avail - b.min))}.`;
        else if (!rem.length) { note = `${label} solo da tiempo a volver: vuelve directo. Te saltas ${out.map((s) => s.name).join(', ')}.`; warn = true; }
        else note = `${label}: ${rem.map((s) => s.name).join(' → ')} → ${t.home.name}. Te saltas ${out.map((s) => s.name).join(', ')}.`;
      }
    }
    planEl.hidden = !dl; planEl.textContent = note; planEl.classList.toggle('warn', warn);
    lastRem = rem;
    const auto = cand.filter((s) => !rem.includes(s)).map((s) => s.id);

    // Google Maps: sin origen, así sale desde donde estés de verdad
    const gm = (pts: (Pt & { maps?: string })[]) => {
      const v = (p: Pt & { maps?: string }) => encodeURIComponent(p.maps ?? `${p.lat.toFixed(5)},${p.lng.toFixed(5)}`);
      const d = pts[pts.length - 1], w = pts.slice(0, -1);
      return `https://www.google.com/maps/dir/?api=1&travelmode=${P.mode === 'walking' ? 'walking' : 'driving'}&destination=${v(d)}` + (w.length ? `&waypoints=${w.map(v).join('%7C')}` : '');
    };
    const homeP = { lat: t.home.lat, lng: t.home.lng };
    ($('trip-gm') as HTMLAnchorElement).href = gm([...rem, homeP]);
    const g1 = $('trip-gm1') as HTMLAnchorElement; g1.href = rem.length ? gm([rem[0]]) : '#'; g1.setAttribute('aria-disabled', String(!rem.length));
    g1.textContent = rem.length ? `Solo hasta ${rem[0].name}` : 'Solo hasta la próxima parada';
    ($('trip-home') as HTMLAnchorElement).href = gm([homeP]);
    const sk = $('trip-skip') as HTMLButtonElement; sk.disabled = !rem.length; sk.setAttribute('aria-disabled', String(!rem.length));
    sk.textContent = rem.length ? `Saltar ${rem[0].name}` : 'Saltar la siguiente parada';

    // Recorrido que queda (con caché para no recalcular lo mismo)
    const seq: Place[] = [t.from, ...rem, t.home];
    const key = keyOf(seq);
    if (!tRoute || tRoute.key !== key) {
      $('tr-km').textContent = '…';
      try {
        let r; try { r = await osrm(seq, true); } catch { r = await osrm(seq, false); }
        tRoute = { key, geom: r.geometry.coordinates.map(([x, y]: number[]) => [y, x]), legKm: r.legs.map((l: any) => l.distance / 1000), legMin: r.legs.map((l: any) => l.duration / 60 * 1.1), real: true };
      } catch {
        const legKm = seq.slice(1).map((p, i) => hav(seq[i], p) * 1.3);
        tRoute = { key, geom: seq.map((p) => [p.lat, p.lng]), legKm, legMin: legKm.map((k) => k / 50 * 60), real: false };
      }
      if (my !== tSeq || !trip) return; // ha cambiado algo mientras calculaba
    }
    const R = tRoute;
    const ak = [0], am = [0]; R.legKm.forEach((k, i) => { ak.push(ak[i] + k); am.push(am[i] + R.legMin[i]); });
    const km = ak[ak.length - 1], drive = am[am.length - 1];
    const dwell = rem.reduce((a, s) => a + stopMin(s), 0);
    // hora a la que llegas a cada parada, contando lo que paras en las anteriores
    const arr = rem.map((_, i) => now.getTime() + (am[i + 1] + rem.slice(0, i).reduce((a, s) => a + stopMin(s), 0)) * 60000);
    const eta = new Date(now.getTime() + (drive + dwell) * 60000);
    $('tr-km').textContent = String(Math.round(km));
    $('tr-time').textContent = fmtMin(drive);
    $('tr-eta').textContent = clock(eta);
    $('tr-stops').textContent = String(rem.length);

    // Aviso de anochecer
    const sun = $('trip-sun') as HTMLElement, ss = sunset(now, t.from);
    sun.hidden = !ss; sun.classList.remove('warn');
    if (ss) {
      const gap = (ss.getTime() - eta.getTime()) / 60000;
      const fit = t.budget.k === 'none' ? ' <button type="button" class="lnk" id="sun-fit">Ajustar para llegar de día</button>' : '';
      if (now > ss) { sun.innerHTML = `Ya ha anochecido (a las ${clock(ss)}). Ojo con la visibilidad y los animales en la carretera.`; sun.classList.add('warn'); }
      else if (gap < 0) { sun.innerHTML = `Anochece a las ${clock(ss)} y llegarías a las ${clock(eta)}: unos ${fmtMin(-gap)} de noche.${fit}`; sun.classList.add('warn'); }
      else if (gap < 30) { sun.innerHTML = `Llegas justo: anochece a las ${clock(ss)}, unos ${fmtMin(gap)} después de tu llegada.${fit}`; sun.classList.add('warn'); }
      else sun.textContent = `Anochece a las ${clock(ss)}. Vas bien de luz: llegas unos ${fmtMin(gap)} antes.`;
    }

    // Comer: el sitio que te pilla de camino a buena hora
    const atStop = t.next > 0 && hav(t.from, P.stops[t.next - 1]) < 0.6 ? P.stops[t.next - 1] : null;
    const win = (ms: number) => { const d = new Date(ms), h = d.getHours() + d.getMinutes() / 60; return h >= 9.5 && h < 12 ? 'almuerzo' : h >= 13.5 && h < 15.75 ? 'comida' : ''; };
    const slots = [...(atStop ? [{ s: atStop, at: now.getTime(), here: true }] : []), ...rem.map((s, i) => ({ s, at: arr[i], here: false }))];
    let pick: { e: Eat; s: Stop; at: number; here: boolean; ty: string } | null = null;
    for (const sl of slots) {
      const ty = win(sl.at); if (!ty) continue;
      const e = P.eats.filter((x) => x.near === sl.s.id && x.types.includes(ty)).sort((a, b) => +!!b.top - +!!a.top)[0];
      if (e) { pick = { e, ty, ...sl }; break; }
    }
    const ep = $('trip-eatpick') as HTMLAnchorElement; ep.hidden = !pick;
    if (pick) {
      ep.href = `https://www.google.com/maps/dir/?api=1&travelmode=driving&destination=${encodeURIComponent(pick.e.q)}`;
      ep.innerHTML = `<b>Te pilla a la hora de ${pick.ty === 'almuerzo' ? 'almorzar' : 'comer'}</b> ${pick.here ? 'aquí mismo' : `en ${esc(pick.s.name)}, hacia las ${clock(pick.at)}`}: <b>${esc(pick.e.name)}</b>. ${esc(pick.e.desc)}`;
    }

    // Lista de lo que queda
    const rows = rem.map((s, i) => `<li><span class="hito"><b>${Math.round(ak[i + 1])}</b><small>km</small></span><div><h3>${esc(s.name)} <span class="kind">${esc(s.kind)}</span>${prioTag(s)}</h3><div class="t">hacia las ${clock(arr[i])}${dwellTxt(s)}</div>${s.note ? `<p class="muted">${esc(s.note)}</p>` : ''}</div></li>`);
    rows.push(`<li><span class="hito"><b>${Math.round(km)}</b><small>km</small></span><div><h3>Llegada <span class="kind">${esc(t.home.name)}</span></h3><div class="t">≈ a las ${clock(eta)}${dwell ? `, contando ~${fmtMin(dwell)} de paradas` : ''}${pick ? ' (sin la comida)' : ''}</div></div></li>`);
    const manual = P.stops.filter((s) => t.skip.includes(s.id));
    if (manual.length) rows.push(`<li class="done"><span></span><div><p class="muted">Has decidido saltarte: ${manual.map((s) => esc(s.name)).join(', ')}. <button type="button" class="lnk" id="trip-unskip">Recuperarlas</button></p></div></li>`);
    $('trip-list').innerHTML = rows.join('');

    // Dónde comer en lo que queda
    const ids = rem.map((s) => s.id);
    const ahead = P.eats.filter((e) => e.near && (ids.includes(e.near) || e.near === atStop?.id))
      .sort((x, y) => (x.near === atStop?.id ? -1 : ids.indexOf(x.near!)) - (y.near === atStop?.id ? -1 : ids.indexOf(y.near!))).slice(0, 4);
    const tag: Record<string, string> = { almuerzo: 'Almorzar', comida: 'Comer' };
    ($('trip-eats-box') as HTMLElement).hidden = !ahead.length;
    $('trip-eats').innerHTML = ahead.map((e) => {
      const s = P.stops.find((x) => x.id === e.near)!, here = e.near === atStop?.id;
      return `<a class="eat" href="https://www.google.com/maps/dir/?api=1&travelmode=driving&destination=${encodeURIComponent(e.q)}" target="_blank" rel="noopener"><span class="hito"><b>${here ? 'Aquí' : Math.round(ak[ids.indexOf(e.near!) + 1])}</b><small>${here ? 'donde estás' : 'km de ti'}</small></span><div><h3>${esc(e.name)}</h3><div class="where">${esc(e.where)} · junto a ${esc(s.name)}</div><p>${esc(e.desc)}</p><div class="chips">${e.types.map((x) => `<span class="chip">${tag[x]}</span>`).join('')}${e.top ? '<span class="chip t">Imprescindible</span>' : ''}</div></div></a>`;
    }).join('');

    // Mapa: lo hecho o descartado en gris, lo que queda en rojo, tú en azul
    const off = (i: number) => i < t.next || t.skip.includes(P.stops[i].id) || auto.includes(P.stops[i].id);
    layer.clearLayers();
    if (route) L.polyline(route.geom, { color: '#8c99a8', weight: 4, opacity: .55, dashArray: '6 8' }).addTo(layer);
    const line = L.polyline(R.geom, { color: '#d62f2f', weight: 5, opacity: .9 }).addTo(layer);
    L.marker([t.home.lat, t.home.lng], { icon: pin('S', 'o'), title: 'Casa' }).addTo(layer).bindPopup(`<b>Vuelta</b><br>${esc(t.home.name)}`);
    P.stops.forEach((s, i) => L.marker([s.lat, s.lng], { icon: pin(String(i + 1), off(i) ? 'd' : '') }).addTo(layer)
      .bindPopup(`<b>${esc(s.name)}</b>${i < t.next ? ' · hecho' : off(i) ? ' · te la saltas' : ''}<br>${esc(s.note ?? '')}`));
    L.marker([t.from.lat, t.from.lng], { icon: L.divIcon({ className: '', html: '<span class="pin m"></span>', iconSize: [22, 22], iconAnchor: [11, 11] }), title: 'Estás aquí', zIndexOffset: 1000 }).addTo(layer).bindPopup('<b>Estás aquí</b>');
    map.fitBounds(line.getBounds(), { padding: [24, 24] });

    // Road book: atenúa lo ya hecho o descartado
    $('book').querySelectorAll('li').forEach((li, k) => { const i = k - 1; li.classList.toggle('done', i >= 0 && i < P.stops.length && off(i)); });
  }

  function setTrip(next: Trip | null, msg = '', q: Ask | null = null, scroll = false) {
    trip = next; tripMsg = msg; ask = q; saveTrip(); showTripUI();
    if (trip) { renderTrip(); if (scroll) $('tripband').scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    else if (route) render();
  }
  const moveTo = (n: number, msg: string) => { if (trip) setTrip({ ...trip, next: n, skip: trip.skip.filter((id) => P.stops.findIndex((s) => s.id === id) >= n) }, msg); };

  function startTrip() {
    const prior = trip ?? loadTrip();
    const keep = { skip: prior?.skip ?? [], budget: prior?.budget ?? NOB, t: Date.now() };
    if (!navigator.geolocation) { setTrip({ home: prior?.home ?? defaultHome(), from: prior?.from ?? { ...P.stops[0] }, next: prior?.next ?? 0, ...keep }, 'Tu navegador no da la ubicación: toca «Estoy aquí» en una parada del road book.', null, true); return; }
    const btns = ['trip-go', 'trip-loc'].map((id) => $(id) as HTMLButtonElement);
    const label = btns.map((b) => b.textContent);
    btns.forEach((b) => { b.disabled = true; b.textContent = 'Buscando tu ubicación…'; });
    const done = () => btns.forEach((b, i) => { b.disabled = false; b.textContent = label[i]; });
    navigator.geolocation.getCurrentPosition(async (p) => {
      me = { lat: p.coords.latitude, lng: p.coords.longitude };
      const home = prior?.home ?? defaultHome();
      // el recorrido de referencia es el que sale y vuelve a casa
      if (!route || origin.lat !== home.lat || origin.lng !== home.lng) {
        origin = { ...home };
        const b = P.bases.find((x) => x.lat === home.lat && x.lng === home.lng); if (b) sel.value = 'city:' + b.id;
        trip = null; await compute();
      }
      const d = locate(me, prior);
      done();
      setTrip({ home, from: { ...me, name: 'Tu ubicación' }, next: d.next, ...keep }, d.msg, d.ask ?? null, !prior);
    }, () => {
      done();
      if (prior) setTrip({ ...prior }, 'No he podido leer tu ubicación: sigo desde donde lo dejaste. Revisa el permiso del navegador.');
      else { const rs = $('trip-resume') as HTMLElement; rs.hidden = false; rs.textContent = 'No he podido obtener tu ubicación. Revisa el permiso del navegador o toca «Estoy aquí» en una parada del road book.'; }
    }, { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 });
  }

  $('trip-go').addEventListener('click', startTrip);
  $('trip-loc').addEventListener('click', startTrip);
  $('trip-drop').addEventListener('click', () => { try { localStorage.removeItem(TKEY); } catch {} showTripUI(); });
  $('trip-end').addEventListener('click', () => setTrip(null));
  $('ask-yes').addEventListener('click', () => { if (ask && trip) moveTo(ask.yes, 'Vale.'); });
  $('ask-no').addEventListener('click', () => { if (ask && trip) moveTo(ask.no, 'Vale.'); });
  $('fix-ahead').addEventListener('click', () => { if (trip) moveTo(trip.next + 1, `Vale, ya has pasado por ${P.stops[trip.next].name}.`); });
  $('fix-back').addEventListener('click', () => { if (trip) moveTo(trip.next - 1, `Vale, aún no has llegado a ${P.stops[trip.next - 1].name}.`); });
  const setBudget = (b: Budget) => { if (trip) { tMat = null; setTrip({ ...trip, budget: b }, tripMsg, ask); } };
  $('budget').addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('.f'); if (!b || !trip) return;
    const v = b.dataset.b!, form = $('until-form') as HTMLFormElement;
    form.hidden = v !== 'until';
    if (v === 'until') { const i = $('until') as HTMLInputElement; if (!i.value) i.value = clock(Date.now() + 2 * 3600e3); i.focus(); return; }
    if (v === 'none') setBudget(NOB);
    else if (v === 'sun') setBudget({ k: 'sun', key: 'sun', label: 'Para llegar de día' });
    else setBudget({ k: 'min', key: v, label: `Con ${fmtMin(+v)}`, at: Date.now() + +v * 60000 });
  });
  $('until-form').addEventListener('submit', (ev) => {
    ev.preventDefault();
    const [h, m] = ($('until') as HTMLInputElement).value.split(':').map(Number); if (isNaN(h)) return;
    const d = new Date(); d.setHours(h, m || 0, 0, 0);
    ($('until-form') as HTMLFormElement).hidden = true;
    setBudget({ k: 'until', key: 'until', label: `Para estar en ${trip?.home.name ?? 'casa'} a las ${clock(d)}`, at: d.getTime() });
  });
  $('trip-sun').addEventListener('click', (ev) => { if ((ev.target as HTMLElement).id === 'sun-fit') setBudget({ k: 'sun', key: 'sun', label: 'Para llegar de día' }); });
  $('trip-skip').addEventListener('click', () => { const r = lastRem; if (trip && r.length) setTrip({ ...trip, skip: [...trip.skip, r[0].id] }, `Te saltas ${r[0].name}.`); });
  $('trip-list').addEventListener('click', (ev) => { if ((ev.target as HTMLElement).id === 'trip-unskip' && trip) setTrip({ ...trip, skip: [] }, 'Paradas recuperadas.'); });
  $('book').addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('.here'); if (!b) return;
    const i = +b.dataset.i!, s = P.stops[i], prior = trip ?? loadTrip();
    setTrip({ home: prior?.home ?? defaultHome(), from: { lat: s.lat, lng: s.lng, name: s.name }, next: i + 1, skip: (prior?.skip ?? []).filter((id) => P.stops.findIndex((x) => x.id === id) > i), budget: prior?.budget ?? NOB, t: Date.now() }, `Estás en ${s.name}: sigues desde aquí.`, null, true);
  });
  // Si cambias la salida con la ruta en marcha, la vuelta pasa a ser esa
  sel.addEventListener('change', () => { if (trip && sel.value.startsWith('city:')) { trip.home = { ...P.bases.find((b) => 'city:' + b.id === sel.value)! }; saveTrip(); } });
  showTripUI();

  // Arranque: la última salida usada, o la primera ciudad base
  let saved = ''; try { saved = localStorage.getItem('plans-origin') || ''; } catch {}
  if (saved.startsWith('city:') && P.bases.some((b) => 'city:' + b.id === saved)) { sel.value = saved; origin = { ...P.bases.find((b) => 'city:' + b.id === saved)! }; }
  else if (saved === 'me') { sel.value = 'me'; useMe(); }
  compute();
</script>
